import model SMEFTsim_topU3l_MwScheme_UFO-decay_noYukawa

define p = g u u~ d d~ s s~ c c~ b b~
define j = g u u~ d d~ s s~ c c~ b b~

define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm
define vl~ = ve~ vm~

generate p p > h l+ l- NP=0 NPprop=0 SMHLOOP=0, h > l+ l- l+ l- NP<=1 NPprop=0 SMHLOOP=0
add process p p > h vl vl~ NP=0 NPprop=0 SMHLOOP=0, h > l+ l- l+ l- NP<=1 NPprop=0 SMHLOOP=0

output ZH_lep_SMEFTsim_topU3l -nojpeg
