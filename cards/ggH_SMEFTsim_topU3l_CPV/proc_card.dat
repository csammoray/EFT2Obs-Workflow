import model SMEFTsim_topU3l_MwScheme_UFO-massless_5FS_CPV

define p = g u u~ d d~ s s~ c c~ b b~
define j = g u u~ d d~ s s~ c c~ b b~

generate p p > h QED=1 NP_TBC=0 NPprop_TBC=0 SMHLOOP=1
add process p p > h j QED=1 NP_TBC=0 NPprop_TBC=0 SMHLOOP=1
add process p p > h j j QED=1 NP_TBC=0 NPprop_TBC=0 SMHLOOP=1

output ggH_SMEFTsim_topU3l_CPV -nojpeg